# AtlasCMS: проект размещён в documentRoot (public_html на виртуальном хостинге).
# Все запросы перенаправляются в подкаталог public/ (там лежит index.php Laravel).
# Директивы написаны совместимо с Apache 2.2 и 2.4 (без Require, который на
# некоторых хостингах вызывает 500).

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Временный распаковщик деплоя: выполняется напрямую, без редиректа в public/
    RewriteRule ^_unpack\.php$ - [L,NC]

    # Запросы, уже идущие в public/, не трогаем
    RewriteRule ^public(/|$) - [L,NC]

    # Остальное перенаправляем в public/ (несуществующие файлы/каталоги)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# ---------------------------------------------------------------------------
# Защита служебных файлов и каталогов от прямого доступа через HTTP.
# ---------------------------------------------------------------------------

# Чувствительные файлы проекта (запрет через mod_access_compat — работает
# и на Apache 2.2, и на 2.4 без модуля authz_core)
<FilesMatch "^(\.env|\.env\..*|\.htaccess|artisan|composer\.json|composer\.lock|phpunit\.xml)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Служебные каталоги: 403 при обращении извне
RedirectMatch 403 ^/(app|bootstrap|config|database|docs|resources|routes|storage|tests|vendor|log1c)(/|$)