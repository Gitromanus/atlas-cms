# AtlasCMS: documentRoot = public_html (весь проект Laravel).
# Запросы уходят в public/ (index.php). Публичные файлы: public/storage → storage/app/public.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteRule ^_unpack\.php$ - [L,NC]
    RewriteRule ^public(/|$) - [L,NC]

    # Корень → public/
    RewriteRule ^$ public/ [L]

    # Существующие файлы отдаём как есть; остальное → public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Чувствительные файлы
<FilesMatch "^(\.env|\.env\..*|\.htaccess|artisan|composer\.json|composer\.lock|phpunit\.xml)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Служебные каталоги. НЕ блокируем /storage целиком —
# публичные картинки доступны как /storage/... через public/storage (symlink).
RedirectMatch 403 ^/(app|bootstrap|config|database|docs|resources|routes|tests|vendor|log1c)(/|$)
RedirectMatch 403 ^/storage/(app|framework|logs)(/|$)
